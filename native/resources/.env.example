# database-operations-mcp — environment template (no secrets)
# Copy to .env and fill in local values. Never commit .env.
MCP_TRANSPORT=dual
MCP_HOST=127.0.0.1
MCP_PORT=10709
CORS_ORIGINS=http://127.0.0.1:10708,http://localhost:10708,http://127.0.0.1:10709,http://localhost:10709
LOG_LEVEL=INFO
# Dev only: set to 1 to allow storing connection passwords (insecure, never in production)
ENABLE_PASSWORD_STORAGE=0
